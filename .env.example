# CodeLens environment variables — copy to .env.local (dev) or set in your host's dashboard (prod)
# and fill in real values. See README "Deployment" for the full setup guide.

# ── Database (Turso / libSQL) ────────────────────────────────────────────────
# In dev, leave BOTH unset to use a local SQLite file (codelens.db) instead.
# Create with: turso db create codelens && turso db show codelens --url && turso db tokens create codelens
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFOORTQSI77nR5cCI6IkpXVCJ9.your-token-here.your-signature

# ── Auth.js (required in prod; sign-in is disabled without these) ──────────
# Generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=replace-with-a-32-byte-base64-random-string

# GitHub OAuth app — create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github (dev)
#             + https://your-domain.vercel.app/api/auth/callback/github (prod)
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# ── Optional: run console ────────────────────────────────────────────────────
# Set to 1 ONLY on a host with a local JDK (serverless functions have none).
# Inlined at build time — rebuild after changing it.
# NEXT_PUBLIC_ENABLE_RUN=1
